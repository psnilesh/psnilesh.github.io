{
  "name": "psnilesh-blog",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npx @11ty/eleventy",
    "serve": "npm run build:css && npx @11ty/eleventy --serve",
    "build:css": "sass assets/main.scss _site/assets/main.css",
    "test": "node --test apps/options/test/*.test.js",
    "test:integration": "node --test apps/options/test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "highlight.js": "^11.11.1",
    "jsdom": "^31.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "sass": "^1.69.5"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0"
  }
}
